    {
      "DownstreamPathTemplate": "/api/Recommendation/new",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5000
        }
      ],
      "UpstreamPathTemplate": "/Recommendation/new",
      "UpstreamHttpMethod": [ "GET" ]
    },
    // Basket.API
    {
      "DownstreamPathTemplate": "/api/Basket/{userId}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5001
        }
      ],
      "UpstreamPathTemplate": "/basket/{userId}",
      "UpstreamHttpMethod": [ "GET", "DELETE", "POST" ]
    },
    {
      "DownstreamPathTemplate": "/api/Basket/{userId}/items",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5001
        }
      ],
      "UpstreamPathTemplate": "/basket/{userId}/items",
      "UpstreamHttpMethod": [ "POST" ]
    },
    {
      "DownstreamPathTemplate": "/api/Basket/{userId}/items/{bookId}",
      "DownstreamScheme": "https",
