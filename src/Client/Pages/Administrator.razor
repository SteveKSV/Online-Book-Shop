@page "/administrator"
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Authorization
@inject HttpClient Http
@inject IConfiguration _configuration

@attribute [Authorize(Roles = "Admin")]

<div class="container py-4">
    <h2 class="text-center mb-4">Books’ Classification</h2>

    <!-- Action Buttons -->
    <div class="d-flex flex-wrap justify-content-center gap-2 mb-4">
        <button @onclick="PreviousBook" class="btn btn-outline-secondary" disabled="@IsFirstBook">← Previous</button>
        <button @onclick="NextBook" class="btn btn-outline-secondary" disabled="@IsLastBook">Next →</button>
        <button @onclick="SkipBook" class="btn btn-outline-warning">Skip (Accept Model's Genre)</button>
        <button @onclick="LoadMoreBooks" class="btn btn-outline-info">Load More Books</button>
        <button @onclick="SubmitReviewedBooks" class="btn btn-success" disabled="@IsSubmitButtonDisabled">Submit Reviewed Books</button>
    </div>

    <!-- Info panel -->
    <div class="text-center text-muted mb-3">
        <p>Labeled Books: <strong>@ReviewedBooks.Count</strong> / @Books.Count</p>
        <p>Current Book: <strong>@(@CurrentBookIndex + 1)</strong> of @Books.Count</p>
    </div>

    <!-- Status / Error Message -->
    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show position-relative" role="alert">
            @StatusMessage
            <button type="button" class="close-btn" @onclick="() => StatusMessage = null" aria-label="Close">&times;</button>
        </div>
    }

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show position-relative" role="alert">
            @ErrorMessage
            <button type="button" class="close-btn" @onclick="() => ErrorMessage = null" aria-label="Close">&times;</button>
        </div>
    }

    <!-- Book Details -->
    @if (CurrentBook != null)
    {
        <div class="book-details mb-4">
            <h3 class="text-center">@CurrentBook.Title</h3>
            <p class="text-justify">@CurrentBook.Description</p>
        </div>

        <!-- Predictions -->
        <h4 class="text-center mb-3">Predicted Genres</h4>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3">
            @foreach (var genre in Predictions.OrderByDescending(g => g.Probability))
            {
                <div class="col">
                    <div class="genre-card p-3 border rounded text-center h-100">
                        <h6>@genre.Name</h6>
                        <p class="text-muted mb-2">@(genre.Probability)%</p>
                        <button @onclick="() => IsGenreSelected(genre.Name) ? UnselectGenre(genre.Name) : SelectGenre(genre.Name)"
                                class="btn btn-sm w-100 @(IsGenreSelected(genre.Name) ? "btn-danger" : "btn-primary")">
                            @(IsGenreSelected(genre.Name) ? "Unselect" : "Select")
                        </button>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-center text-muted">Loading books...</p>
    }
</div>
