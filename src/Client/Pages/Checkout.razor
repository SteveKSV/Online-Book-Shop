@page "/checkout"
@attribute [Authorize]
@using Client.Models.Ordering
@using Client.Services.Interfaces
@inject IOrderService OrderService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider _authStateProvider

<div class="d-flex justify-content-center align-items-start min-vh-100 pt-5 bg-light">
    <div class="card shadow p-4" style="width: 100%; max-width: 600px;">
        <EditForm Model="BasketCheckout" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <h3 class="text-center mb-4">Billing Information</h3>

            <div class="mb-3">
                <label class="form-label">First Name *</label>
                <InputText class="form-control" @bind-Value="BasketCheckout.FirstName" />
                <ValidationMessage For="@(() => BasketCheckout.FirstName)" />
            </div>

            <div class="mb-3">
                <label class="form-label">Last Name *</label>
                <InputText class="form-control" @bind-Value="BasketCheckout.LastName" />
                <ValidationMessage For="@(() => BasketCheckout.LastName)" />
            </div>

            <div class="mb-3">
                <label class="form-label">Email Address *</label>
                <InputText class="form-control" @bind-Value="BasketCheckout.EmailAddress" />
                <ValidationMessage For="@(() => BasketCheckout.EmailAddress)" />
            </div>

            <div class="mb-3">
                <label class="form-label">Address *</label>
                <InputText class="form-control" @bind-Value="BasketCheckout.Address" />
                <ValidationMessage For="@(() => BasketCheckout.Address)" />
            </div>

            <h3 class="text-center mb-4">Payment</h3>

            <div class="mb-3">
                <label class="form-label">Payment Method *</label>
                <InputSelect class="form-select" @bind-Value="BasketCheckout.PaymentMethodId" onchange="OnPaymentMethodChanged">
                    <option value="">-- Select Payment Method --</option>
                    @foreach (var method in PaymentMethods)
                    {
                        <option value="@method.Id">@method.Name</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => BasketCheckout.PaymentMethodId)" />
            </div>

            @if (IsCreditCardSelected)
            {
                <div class="mb-3">
                    <label class="form-label">Card Number *</label>
                    <InputText class="form-control" @bind-Value="BasketCheckout.CardNumber" />
                    <ValidationMessage For="@(() => BasketCheckout.CardNumber)" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Expiration (MM/YY or MM/YYYY) *</label>
                    <InputText class="form-control" @bind-Value="BasketCheckout.Expiration" placeholder="MM/YY or MM/YYYY" />
                    <ValidationMessage For="@(() => BasketCheckout.Expiration)" />
                </div>

                <div class="mb-3">
                    <label class="form-label">CVV *</label>
                    <InputText class="form-control" @bind-Value="BasketCheckout.CVV" />
                    <ValidationMessage For="@(() => BasketCheckout.CVV)" />
                </div>
            }

            @if (ShowCardValidationErrors)
            {
                <div class="alert alert-danger">
                    Please fill all credit card fields.
                </div>
            }

            <button class="btn btn-primary w-100 mt-3" type="submit">Submit Order</button>
        </EditForm>
    </div>
</div>
