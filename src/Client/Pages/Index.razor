@page "/"
@using Client.Models
@using Client.Services.Interfaces

@layout MainLayout
@inject NavigationManager NavigationManager
@inject ICatalogService Service
@inject IShoppingCartService CartService
@inject HttpClient Http

<PageTitle>Home</PageTitle>

<main class="d-flex flex-column align-items-md-center justify-content-center container text-center">
    <h1 class="text-primary display-4">WhatToRead</h1>
    <p class="text-muted lead">Discover your next favorite book!</p>

    <!-- Search Bar -->
    <div class="input-group mx-auto search-bar">
        <input type="text" class="form-control rounded" @bind="searchQuery" placeholder="Search for books..." @oninput="StateHasChanged" />
        <button class="btn btn-primary rounded-end-pill d-flex align-items-center justify-content-center px-3 search-button" @onclick="SearchBooks">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
            </svg>
        </button>
    </div>

    <!-- Top Rated Books -->
    <div class="mt-5 w-100">
        <h2 class="text-secondary mb-4">Top Rated Books</h2>

        @if (topBooks == null)
        {
            <p>Loading...</p>
        }
        else
        {
            <div class="carousel-controls d-flex justify-content-between align-items-center position-relative w-100">
                <button class="carousel-arrow left" @onclick="ShowPrevious" disabled="@(currentIndex == 0)">&#8249;</button>

                <div class="book-carousel-container flex-grow-1 px-3">
                    <div class="book-carousel" style="transform: translateX(@GetTranslateX());">
                        @foreach (var book in topBooks)
                        {
                             <a href="/bookdetails/@book.Title" class="col-6 col-sm-12 col-md-6 col-lg-4 col-xl-4 mh-25 mb-4 card-anchor">
                                <div class="book-card">
                                    <div class="card shadow-sm rounded h-100">
                                        <div class="card-body d-flex flex-column">
                                            <h5 class="card-title"><b>@TruncateTitle(book.Title, 50)</b></h5>
                                            <p class="card-subtitle mb-2 text-muted text-md-center">@book.Authors</p>
                                                <img src="@book.Image" alt="@book.Title" class="img-fluid mb-2" />
                                            <div class="mt-auto d-flex justify-content-between">
                                                <span>$@($"{book.Price:F2}")</span>
                                                <div>
                                                    @for (int i = 1; i <= 5; i++)
                                                    {
                                                        <span class="@(i <= book.RatingsCount ? "text-warning" : "text-muted")">
                                                            @(i <= book.RatingsCount ? "★" : "☆")
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                            <button class="btn btn-primary mt-2" @onclick="() => AddToCart(book)">Buy</button>
                                        </div>
                                    </div>
                                </div>
                             </a>
                        }
                    </div>
                </div>

                <button class="carousel-arrow right" @onclick="ShowNext" disabled="@(currentIndex + booksPerPage >= topBooks?.Count)">&#8250;</button>
            </div>
        }
    </div>
</main>

@code {
    private string searchQuery = "";
    private List<BookModel>? topBooks;

    private int currentIndex = 0;
    private int booksPerPage = 3;
    private List<BookModel> PagedBooks => topBooks?.Skip(currentIndex).Take(booksPerPage).ToList() ?? new();

    protected override async Task OnInitializedAsync()
    {
        string queryString = "?pageNumber=1&pageSize=10&sortRating=desc";
        var (loadedBooks, _) = await Service.GetBooks(queryString);
        topBooks = loadedBooks;
    }

    private void SearchBooks()
    {
        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            NavigationManager.NavigateTo($"/catalog?pageSize=9&title={searchQuery}");
        }
        else
        {
            NavigationManager.NavigateTo("/catalog?pageSize=9");
        }
    }

    private string GetTranslateX()
    {
        var percent = (currentIndex / (double)topBooks!.Count) * 100;
        return $"-{percent}%";
    }

    private async Task AddToCart(BookModel book)
    {
        var item = new ShoppingCartItem
        {
            ProductId = book.Id,
            ProductName = book.Title,
            Price = book.Price,
            Quantity = 1,
            ProductImage = book.Image,
        };

        await CartService.AddToCart(item);
        StateHasChanged();
    }

    private string TruncateTitle(string title, int maxLength)
    {
        return string.IsNullOrEmpty(title) || title.Length <= maxLength ? title : title.Substring(0, maxLength) + "...";
    }

    private void NavigateToDetails(string id)
    {
        NavigationManager.NavigateTo($"/bookdetails/{id}");
    }

    private void ShowNext()
    {
        if (topBooks == null) return;
        if (currentIndex + booksPerPage < topBooks.Count)
        {
            currentIndex += booksPerPage;
        }
    }

    private void ShowPrevious()
    {
        if (currentIndex - booksPerPage >= 0)
        {
            currentIndex -= booksPerPage;
        }
    }

}
