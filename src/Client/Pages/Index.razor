@page "/"
@layout MainLayout
@inject NavigationManager NavigationManager

<PageTitle>Home</PageTitle>
<style>
    .image-container {
        max-width: 600px; /* Keeps image smaller */
        max-height: 350px; /* Restricts height to avoid scrolling */
        overflow: hidden; /* Ensures no extra space */
    }
</style>

<main class="d-flex flex-column align-items-md-center justify-content-center container text-center mt-5">
    <h1 class="text-primary display-4">WhatToRead</h1>
    <p class="text-muted lead">Discover your next favorite book!</p>

    <!-- Search Bar -->
    <div class="search-container mt-4">
        <input type="text" @bind="searchQuery" class="form-control w-50 d-inline" placeholder="Search for books...">
        <button class="btn btn-primary" @onclick="SearchBooks">Search</button>
    </div>

    <div class="mt-5 d-flex justify-content-center image-container ">
        <div class="rounded shadow-lg">
            <img src="https://orange-publishers.com/wp-content/uploads/2022/02/book-page-1005324.jpg" alt="Books Collection" class="img-fluid rounded shadow-lg">
        </div>
    </div>
</main>

@code {
    private string searchQuery = "";

    private void SearchBooks()
    {
        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            NavigationManager.NavigateTo($"/catalog?pageSize=9&title={searchQuery}");
        }
        else
        {
            NavigationManager.NavigateTo("/catalog?pageSize=9");
        }
    }
}
