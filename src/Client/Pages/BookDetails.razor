@page "/bookdetails/{bookTitle}"

@using Client.Models
@inject NavigationManager Navigation

<div class="container py-5">
    <button class="btn btn-outline-secondary mb-3" @onclick="GoBack">
        <i class="bi bi-arrow-left"></i> Go Back
    </button>

    @if (Book != null)
    {
        <div class="row">
            <div class="col-md-4">
                <div class="card shadow-sm">
                    <img src="@Book.Image" class="img-fluid card-img-top" alt="Book Cover" style="max-width: 100%; height: 500px;" />
                    <div class="card-body text-center">
                        <h3 class="card-title">@Book.Title</h3>
                        <p class="card-text fw-bold text-primary">$@String.Format("{0:F2}", Book.Price)</p>
                        <button type="button" class="btn btn-primary w-100" @onclick="() => AddToCart(Book)">
                            <i class="bi bi-cart3 me-1"></i> Buy Now
                        </button>
                    </div>
                </div>
            </div>

            <div class="col-md-8">
                <div class="card shadow-sm p-4">
                    <h4 class="mb-3">Book Details</h4>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item"><strong>Author:</strong> @Book.Authors</li>
                        <li class="list-group-item"><strong>Genre:</strong> @Book.Genres</li>
                        <li class="list-group-item"><strong>Publisher:</strong> @Book.Publisher</li>
                        <li class="list-group-item"><strong>Publication Date:</strong> @Book.PublicationDate.ToString("dd/MM/yyyy")</li>
                        <li class="list-group-item"><strong>Ratings Count:</strong> @Book.RatingsCount</li>
                    </ul>

                    <h5 class="mt-4">Description</h5>
                    <p class="text-muted">@Book.Description</p>

                    <div class="reviews mt-4">
                        <h5>Reviews</h5>
                        <p class="text-secondary">There are no reviews now.</p>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning text-center" role="alert">
            Book not found.
        </div>
    }
</div>