@page "/bookdetails/{BookId:guid}"

@using Client.Models
@using Client.Shared

<div class="container py-5">
    <button class="btn btn-outline-secondary mb-3" @onclick="GoBack">
        <i class="bi bi-arrow-left"></i> Go Back
    </button>

    @if (Book != null)
    {
        <div class="row">
            <div class="col-md-4">
                <div class="card shadow-sm">
                    <img src="@Book.CoverImage" class="img-fluid card-img-top" alt="Book Cover" style="max-width: 100%; height: 500px;" />
                    <div class="card-body text-center">
                        <h3 class="card-title">@Book.Title</h3>
                        <p class="card-text fw-bold text-primary">$@String.Format("{0:F2}", Book.Price)</p>
                        <button type="button" class="btn btn-primary w-100" @onclick="() => AddToCart(Book)">
                            <i class="bi bi-cart3 me-1"></i> Buy Now
                        </button>
                    </div>
                </div>
            </div>

            <div class="col-md-8">
                <div class="card shadow-sm p-4">
                    <h4 class="mb-3">Book Details</h4>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item"><strong>Author:</strong> @Book.Authors</li>
                        <li class="list-group-item"><strong>Genre:</strong> @Book.GenreName</li>
                        <li class="list-group-item"><strong>Publisher:</strong> @Book.Publisher</li>
                        <li class="list-group-item"><strong>Publication Date:</strong> @Book.PublishedAt.ToString()</li>
                        <li class="list-group-item">
                            <span class="ms-2">@RenderStars(Book.AverageRating)</span>
                            <span class="ms-2 text-muted">@($"{Book.AverageRating:F1}")</span>
                        </li>
                    </ul>

                    @if (IsLoggedIn)
                    {
                        <div class="my-3">
                            <h6>Your Rating:</h6>
                            @for (int i = 1; i <= 5; i++)
                            {
                                var starValue = i;
                                <i class="bi @(starValue <= SelectedRating ? "bi-star-fill" : "bi-star") text-warning me-1"
                                   style="cursor:pointer;"
                                   @onclick="@(() => Rate(starValue))"></i>
                            }
                            @if (RatingStatus != null)
                            {
                                <div class="mt-2 text-success">@RatingStatus</div>
                            }
                        </div>
                    }
                    <h5 class="mt-4">Description</h5>
                    <p class="text-muted">@Book.Description</p>

                   <div class="reviews mt-4">
                        <h5>Reviews</h5>
                        <CommentsComponent BookId="Book.Id" IsLoggedIn="IsLoggedIn" />
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning text-center" role="alert">
            Book not found.
        </div>
    }
</div>

